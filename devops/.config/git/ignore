# Global git ignore (XDG: ~/.config/git/ignore, read automatically by git).
#
# Keep this strictly for things that are global to the user/machine and never
# meaningful to commit anywhere: OS cruft, editor scratch files, and local-only
# tool settings. Project-specific build artifacts belong in that project's own
# .gitignore, not here.

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# Editor scratch files
*~
*.swp
*.swo
.*.sw[a-p]

# Claude Code local settings (per-checkout, never shared)
**/.claude/settings.local.json
